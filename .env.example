# Supabase (required)
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-jwt

# Supabase (server-side, required for DB writes)
# Keep secret. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt

# Client (Vite) env vars (browser bundle)
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Server Configuration
PORT=5000
NODE_ENV=development

# Python detector service base URL
# Local default is http://127.0.0.1:8000
DETECTOR_BASE_URL=http://127.0.0.1:8000

# Client-side detector URL for direct browser TTS calls
VITE_DETECTOR_BASE_URL=http://127.0.0.1:8000

# Client-side API base URL for frontend -> backend calls
# Leave empty for same-origin local dev; set in Vercel for external backend.
VITE_API_BASE_URL=

# Detector service CORS allowlist (comma-separated)
# Example: CORS_ORIGINS=https://your-frontend.vercel.app,https://your-admin.example.com
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
